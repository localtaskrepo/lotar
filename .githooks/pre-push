#!/usr/bin/env bash
# Git pre-push hook for LoTaR (DEV-162).
#
# Quick, read-only checks for what the push changes; CI (and the pre-release
# CI review) runs the full test, build and smoke suites. Rust and frontend
# checks run in parallel and only when files of that kind changed:
#   Rust:     cargo fmt --check, clippy (lib + bins, -D warnings)
#   Frontend: vue-tsc typecheck, ESLint, Prettier check
#
# Install: npm run hooks:install   Bypass once: git push --no-verify

set -euo pipefail

export PATH="$HOME/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

zero="0000000000000000000000000000000000000000"
changed=""
# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote ref
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # New branch (or unknown remote state): compare against the upstream
    # default branch when available, else check everything.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ]; then
    changed+="$(git diff --name-only "$base" "$local_sha")"$'\n'
  else
    changed+="ALL"$'\n'
  fi
done

needs_rust=0
needs_web=0
if grep -qx "ALL" <<<"$changed"; then
  needs_rust=1
  needs_web=1
else
  grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)(clippy|rustfmt)\.toml$|^build\.rs$' <<<"$changed" && needs_rust=1
  grep -qE '\.(ts|vue|mjs|mts|cjs|js)$|^package(-lock)?\.json$|^eslint|^\.prettier|view/tsconfig\.json$' <<<"$changed" && needs_web=1
fi

if [ "$needs_rust" -eq 0 ] && [ "$needs_web" -eq 0 ]; then
  echo "pre-push: no Rust or frontend changes; nothing to check."
  exit 0
fi

log_dir="$(mktemp -d)"
trap 'rm -rf "$log_dir"' EXIT

run_rust() {
  cargo fmt --all --check && cargo clippy --lib --bins --all-features --quiet -- -D warnings
}

run_web() {
  if [ ! -d node_modules ]; then
    echo "node_modules missing; run 'npm ci'"
    return 1
  fi
  npx --no-install vue-tsc --project view/tsconfig.json --noEmit &&
    npx --no-install eslint --cache --cache-location node_modules/.cache/eslint/ . &&
    npm run --silent fmt:js:check
}

rust_pid=""
web_pid=""
if [ "$needs_rust" -eq 1 ]; then
  run_rust >"$log_dir/rust.log" 2>&1 &
  rust_pid=$!
fi
if [ "$needs_web" -eq 1 ]; then
  run_web >"$log_dir/web.log" 2>&1 &
  web_pid=$!
fi

failed=0
if [ -n "$rust_pid" ]; then
  if wait "$rust_pid"; then
    echo "✓ Rust: formatting and clippy"
  else
    echo "✗ Rust checks failed:"
    cat "$log_dir/rust.log"
    failed=1
  fi
fi
if [ -n "$web_pid" ]; then
  if wait "$web_pid"; then
    echo "✓ Frontend: typecheck, ESLint and Prettier"
  else
    echo "✗ Frontend checks failed:"
    cat "$log_dir/web.log"
    failed=1
  fi
fi

if [ "$failed" -ne 0 ]; then
  echo "Fix the findings (formatting: npm run fmt) or bypass once with --no-verify."
fi
exit "$failed"
