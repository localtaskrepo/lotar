#!/usr/bin/env bash
# Git pre-commit hook for LoTaR (DEV-162).
#
# Read-only and fast: checks only the files being committed and never
# formats, stages, stashes or checks out anything. Fix findings with
# `npm run fmt` (formatting) or by hand (lint), then commit again.
#
# Install: npm run hooks:install   Bypass once: git commit --no-verify

set -euo pipefail

export PATH="$HOME/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Same scopes as `cargo fmt`, `npm run fmt:js` (Prettier) and `eslint .`.
rust_files=()
prettier_files=()
eslint_files=()
while IFS= read -r -d '' file; do
  case "$file" in
    *.rs) rust_files+=("$file") ;;
  esac
  case "$file" in
    view/*.ts | view/*.vue | smoke/*.ts | scripts/*.mjs) prettier_files+=("$file") ;;
    *.mjs | *.mts) [[ "$file" == */* ]] || prettier_files+=("$file") ;;
  esac
  case "$file" in
    *.ts | *.vue | *.mjs | *.mts | *.cjs | *.js) eslint_files+=("$file") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

web_files=("${prettier_files[@]+"${prettier_files[@]}"}" "${eslint_files[@]+"${eslint_files[@]}"}")
if [ "${#rust_files[@]}" -eq 0 ] && [ "${#eslint_files[@]}" -eq 0 ] && [ "${#prettier_files[@]}" -eq 0 ]; then
  exit 0
fi

# The checks read the working-tree copy; say so when it differs from what
# is staged so a partially staged file is not silently misjudged.
partial=()
for file in "${rust_files[@]+"${rust_files[@]}"}" "${eslint_files[@]+"${eslint_files[@]}"}"; do
  if ! git diff --quiet -- "$file"; then
    partial+=("$file")
  fi
done
if [ "${#partial[@]}" -gt 0 ]; then
  echo "note: checking the working-tree version of partially staged files: ${partial[*]}"
fi

failed=0

if [ "${#rust_files[@]}" -gt 0 ]; then
  if ! command -v rustfmt >/dev/null 2>&1; then
    echo "error: rustfmt not found; install the toolchain from rust-toolchain.toml" >&2
    exit 1
  fi
  if ! rustfmt --check --edition 2024 "${rust_files[@]}" >/dev/null 2>&1; then
    echo "✗ Rust formatting: run 'cargo fmt --all' (files: ${rust_files[*]})"
    failed=1
  fi
fi

if [ "${#web_files[@]}" -gt 0 ]; then
  if [ ! -d node_modules ]; then
    echo "note: node_modules missing; skipped Prettier/ESLint (run 'npm ci')"
  else
    if [ "${#prettier_files[@]}" -gt 0 ] && ! npx --no-install prettier --check --log-level warn "${prettier_files[@]}"; then
      echo "✗ Frontend formatting: run 'npm run fmt:js'"
      failed=1
    fi
    if [ "${#eslint_files[@]}" -gt 0 ] && ! npx --no-install eslint --cache --cache-location node_modules/.cache/eslint/ --no-warn-ignored "${eslint_files[@]}"; then
      echo "✗ ESLint findings above"
      failed=1
    fi
  fi
fi

exit "$failed"
