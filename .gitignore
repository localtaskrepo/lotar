/target
node_modules/
/.parcel-cache/
/public/*
/dist/
/.history/
.playwright-mcp/
/.kilo/
__pycache__/

# .tasks/ is the version-controlled backlog. Only the DEV project and @releases (lotar's
# own releases and their DEV tickets, owner 2026-11-14) are tracked; every other
# project + runtime dir (LOTA, TEST, @sprints, @attachments, scenario data from
# `npm run seed:test-tasks`, …) is local-only so coincidental/test data stays out of git.
.tasks/*/
!.tasks/DEV/
!.tasks/@releases/
.tasks/**/.task.lock
.tasks/**/.sprints.lock
.tasks/**/.releases.lock
.tasks/**/.attachments-store.lock
.tasks-demo/

# npm first-publish workspace (docs/release-guide.md, DEV-250)
/npm-bootstrap/

# Copies scripts/stage-crates.mjs makes for cargo package (DEV-507)
/crates/lotar-lib/docs/
/crates/lotar-web-assets/web-embed/
