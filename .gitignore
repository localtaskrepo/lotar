# .tasks/ is the real, version-controlled backlog for this project — do NOT ignore it.
# Only ignore runtime/local subdirectories so they never get committed:
/.tasks/@attachments/
/.tasks/@reports/
/.tasks/.context/
/.tasks-demo/
