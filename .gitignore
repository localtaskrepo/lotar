/target
node_modules/
/.parcel-cache/
/public/*
/dist/
/.history/
.playwright-mcp/
/.kilo/

# .tasks/ is the version-controlled backlog. Only the DEV project is tracked; every other
# project + runtime dir (LOTA, TEST, @sprints, @attachments, scenario data from
# `npm run seed:test-tasks`, …) is local-only so coincidental/test data stays out of git.
.tasks/*/
!.tasks/DEV/
.tasks/**/.task.lock
.tasks/**/.sprints.lock
.tasks-demo/
