{
    "printWidth": 120,
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "overrides": [
        {
            "files": "*.vue",
            "options": { "tabWidth": 2 }
        },
        {
            "files": ["smoke/**/*.ts", "scripts/**/*.mjs", "*.mjs", "*.mts"],
            "options": { "semi": true }
        }
    ]
}
